model Group {
  id                     String                 @id @default(cuid())
  name                   String
  slug                   String                 @unique
  description            String?                @db.Text
  coverImage             String?
  avatar                 String?
  privacy                GroupPrivacy           @default(PUBLIC)
  discoverability        GroupDiscoverability   @default(VISIBLE)
  joinMode               GroupJoinMode          @default(DIRECT)
  status                 GroupStatus            @default(ACTIVE)
  requiresPostApproval   Boolean                @default(false)
  challengeCreatorPolicy ChallengeCreatorPolicy @default(STAFF)
  version                Int                    @default(1)
  archivedAt             DateTime?
  ownerId                String?
  owner                  User?                  @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdById            String?
  createdBy              User?                  @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)

  members                GroupMember[]
  invitations            GroupInvitation[]
  inviteLinks            GroupInviteLink[]
  posts                  Post[]
  notifications          Notification[]

  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([status, discoverability, createdAt])
  @@index([ownerId])
}

model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       GroupRole @default(MEMBER)
  isApproved Boolean   @default(true)
  createdAt  DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model GroupInvitation {
  id          String                @id @default(cuid())
  groupId     String
  group       Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId   String
  inviter     User                  @relation("GroupInvitationsSent", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId   String
  invitee     User                  @relation("GroupInvitationsReceived", fields: [inviteeId], references: [id], onDelete: Cascade)
  role        GroupRole             @default(MEMBER)
  status      GroupInvitationStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  notifications Notification[]

  @@unique([groupId, inviteeId])
  @@index([inviteeId, status])
  @@index([groupId, status])
  @@map("group_invitations")
}

model GroupInviteLink {
  id          String    @id @default(cuid())
  groupId     String
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("GroupInviteLinksCreated", fields: [createdById], references: [id], onDelete: SetNull)
  token       String    @unique
  isStaffLink Boolean   @default(false)
  expiresAt   DateTime?
  revokedAt   DateTime?
  useCount    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([groupId, revokedAt])
  @@map("group_invite_links")
}

